{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "documentType": {
      "type": "string",
      "enum": [
        "curriculum",
        "timetable",
        "subject_list",
        "unknown"
      ]
    },
    "subjects": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "teacher": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ]
          },
          "control": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "exam",
                  "credit",
                  "graded_credit",
                  "none"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "coursework": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "semester": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              {
                "type": "null"
              }
            ]
          },
          "totalHours": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              {
                "type": "null"
              }
            ]
          },
          "needsReview": {
            "type": "boolean"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "needsReview"
        ],
        "additionalProperties": false
      }
    },
    "lessons": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subjectName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "weekday": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              {
                "type": "null"
              }
            ]
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ]
          },
          "needsReview": {
            "type": "boolean"
          },
          "raw": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "subjectName",
          "needsReview"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 3000
      }
    }
  },
  "required": [
    "documentType",
    "subjects",
    "lessons",
    "warnings"
  ],
  "additionalProperties": false
}
